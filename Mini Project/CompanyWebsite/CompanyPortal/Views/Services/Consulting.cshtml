@{
    ViewData["Title"] = "Consulting";
}

<section class="mb-4">
    <h1 class="display-6 fw-bold">Consulting Services</h1>
    <p class="text-secondary">Focused advice for teams improving architecture, delivery quality, and operational efficiency.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Architecture Review</h2>
                <p class="mb-0">Assess solution structure, identify risks, and define practical next steps.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Process Design</h2>
                <p class="mb-0">Streamline team workflows, release processes, and collaboration points.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Delivery Coaching</h2>
                <p class="mb-0">Guide teams through estimation, execution, and technical decision-making.</p>
            </div>
        </div>
    </div>
</div>

<div class="accordion shadow-sm" id="consultingAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#consultingScope" aria-expanded="true" aria-controls="consultingScope">
                Typical consulting scope
            </button>
        </h2>
        <div id="consultingScope" class="accordion-collapse collapse show" data-bs-parent="#consultingAccordion">
            <div class="accordion-body">Solution audits, backlog shaping, deployment review, and communication plans for stakeholders.</div>
        </div>
    </div>
</div>