@{
    ViewData["Title"] = "About";
}

<section class="mb-4">
    <h1 class="display-6 fw-bold">About CompanyPortal</h1>
    <p class="text-secondary">This page uses Bootstrap alerts and list groups to present company information in a structured way.</p>
</section>

<div class="alert alert-info shadow-sm" role="alert">
    <strong>Mission:</strong> Help businesses launch practical digital solutions with clear processes, fast delivery, and dependable support.
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Core Values</h2>
                <ul class="list-group list-group-flush mt-3">
                    <li class="list-group-item">Customer-first product thinking</li>
                    <li class="list-group-item">Simple, maintainable engineering</li>
                    <li class="list-group-item">Continuous improvement and learning</li>
                    <li class="list-group-item">Transparent project communication</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">What Students Learn Here</h2>
                <ul class="list-group list-group-numbered mt-3">
                    <li class="list-group-item">How a controller action maps to a Razor view</li>
                    <li class="list-group-item">How a shared layout keeps navigation consistent</li>
                    <li class="list-group-item">How Bootstrap speeds up UI composition</li>
                    <li class="list-group-item">How MVC routes remain easy to test manually</li>
                </ul>
            </div>
        </div>
    </div>
</div>