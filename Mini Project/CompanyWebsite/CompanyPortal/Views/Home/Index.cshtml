@{
    ViewData["Title"] = "Home";
}

<section class="hero-section rounded-4 p-4 p-lg-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-12">
            <span class="eyebrow">CompanyPortal</span>
            <h1 class="display-5 fw-bold mt-3">Build modern business experiences with a clean MVC structure.</h1>
            <p class="lead text-secondary mt-3">This portal shows how controllers, views, routing, and a shared Bootstrap layout work together in a simple company website.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Services" asp-action="Index">Explore Services</a>
                <a class="btn btn-outline-dark btn-lg" asp-controller="Products" asp-action="Index">Browse Products</a>
                <button type="button" class="btn btn-outline-primary btn-lg" data-toast-target="#welcomeToast">Show Welcome Toast</button>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                <div>
                    <span class="eyebrow">Bootstrap Toasts</span>
                    <h2 class="h3 mt-3 mb-2">Share quick status updates without leaving the page.</h2>
                    <p class="text-secondary mb-0">Use these examples to preview welcome, success, warning, and error notifications the way a portal would confirm updates and highlight action items.</p>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" class="btn btn-primary" data-toast-target="#welcomeToast">Welcome</button>
                    <button type="button" class="btn btn-success" data-toast-target="#successToast">Success</button>
                    <button type="button" class="btn btn-warning" data-toast-target="#warningToast">Warning</button>
                    <button type="button" class="btn btn-danger" data-toast-target="#errorToast">Error</button>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="welcomeToast" class="toast toast-primary align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3500" data-toast-auto-show="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-start gap-3">
                <span class="toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="currentColor" role="img" focusable="false">
                        <path d="M8 0 1.5 3v4.6C1.5 11.3 4.2 14.6 8 16c3.8-1.4 6.5-4.7 6.5-8.4V3L8 0Zm3.1 6.2L7.3 10 5 7.7l1.1-1.1 1.2 1.2 2.7-2.7 1.1 1.1Z" />
                    </svg>
                </span>
                <div class="toast-copy">
                    <strong class="d-block">Welcome Back</strong>
                    Chandigarh University Company Portal is ready with your latest campus updates.
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <div id="successToast" class="toast toast-success border-0 mt-2" role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="3200">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-start gap-3">
                <span class="toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="currentColor" role="img" focusable="false">
                        <path d="M16 2.5 6 13 0 7l1.4-1.4L6 10.2l8.6-8.7L16 2.5Z" />
                    </svg>
                </span>
                <div class="toast-copy">
                    <strong class="d-block">Update Saved</strong>
                    Your student profile and semester preferences were submitted successfully.
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <div id="warningToast" class="toast toast-warning border-0 mt-2" role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="4200">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-start gap-3 text-dark">
                <span class="toast-icon toast-icon-dark" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="currentColor" role="img" focusable="false">
                        <path d="M8.9 1.5a1 1 0 0 0-1.8 0L.2 13.2A1 1 0 0 0 1 14.7h14a1 1 0 0 0 .8-1.5L8.9 1.5ZM8 5c.4 0 .8.3.8.8v3.3a.8.8 0 1 1-1.6 0V5.8c0-.5.4-.8.8-.8Zm0 6.6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z" />
                    </svg>
                </span>
                <div class="toast-copy">
                    <strong class="d-block">Fee Reminder</strong>
                    One tuition payment milestone is due this week. Review the finance section before Friday.
                </div>
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <div id="errorToast" class="toast toast-danger border-0 mt-2" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4500">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-start gap-3">
                <span class="toast-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="currentColor" role="img" focusable="false">
                        <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm2.8 9.7-1.1 1.1L8 9.1l-1.7 1.7-1.1-1.1L6.9 8 5.2 6.3l1.1-1.1L8 6.9l1.7-1.7 1.1 1.1L9.1 8l1.7 1.7Z" />
                    </svg>
                </span>
                <div class="toast-copy">
                    <strong class="d-block">Report Unavailable</strong>
                    The examination report could not be generated right now. Please try again in a few minutes.
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<section>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column h-100">
                    <h2 class="h4 card-title">Consulting</h2>
                    <p class="card-text mb-4">Strategy workshops, architecture reviews, and delivery planning for growing teams.</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" asp-controller="Services" asp-action="Consulting">View Consulting</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column h-100">
                    <h2 class="h4 card-title">Training</h2>
                    <p class="card-text mb-4">Hands-on learning tracks for .NET, web development, and engineering practices.</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" asp-controller="Services" asp-action="Training">View Training</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column h-100">
                    <h2 class="h4 card-title">Product Suite</h2>
                    <p class="card-text mb-4">Reusable software and internal tools designed to speed up delivery and reporting.</p>
                    <a class="btn btn-outline-primary mt-auto align-self-start" asp-controller="Products" asp-action="Software">View Software</a>
                </div>
            </div>
        </div>
    </div>
</section>
