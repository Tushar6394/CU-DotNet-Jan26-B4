<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickLoan</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Day56.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-4 quickloan-nav shadow-lg">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold quickloan-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="quickloan-logo" aria-hidden="true">
                        <span class="logo-core">Q</span>
                        <span class="logo-pulse"></span>
                    </span>
                    <span>QuickLoan</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-flex justify-content-end w-100">
                    <ul class="navbar-nav ms-auto align-items-sm-center quickloan-menu">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" role="img" focusable="false"><path d="M12 3 3 10.5h2V21h6v-6h2v6h6V10.5h2z"/></svg>
                                </span>
                                <span>Home</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Loan" asp-action="Index">
                                <span class="nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" role="img" focusable="false"><path d="M3 7h18v3H3zm2 5h14v9H5zm2 2v2h2v-2zm4 0v2h6v-2z"/></svg>
                                </span>
                                <span>Loans</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <span class="nav-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" role="img" focusable="false"><path d="M12 2 4 5.5V12c0 5.2 3.4 9.8 8 11 4.6-1.2 8-5.8 8-11V5.5zm0 3 5 2v5c0 3.8-2.3 7.4-5 8.7-2.7-1.3-5-4.9-5-8.7V7z"/></svg>
                                </span>
                                <span>Privacy</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QuickLoan - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
