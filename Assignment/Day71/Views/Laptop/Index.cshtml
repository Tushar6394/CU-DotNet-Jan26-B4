@model Day71.Models.LaptopDashboardViewModel

@{
    ViewData["Title"] = "VoltGear Inventory Dashboard";
    var successMessage = TempData["SuccessMessage"] as string;
}

<div class="inventory-shell">
    <div class="inventory-hero rounded-4 p-4 p-lg-5 mb-5 shadow-lg text-white">
        <div class="row align-items-center g-5">
            <div class="col-lg-8">
                <div class="badge text-bg-light text-uppercase fw-bold mb-3 px-3 py-2">VoltGear Systems</div>
                <h1 class="display-5 fw-bold mb-3">
                    Laptop Inventory Control Center
                </h1>
                <p class="lead mb-0 fw-500">
                    Register, track, and review all laptops in real time from one operational dashboard.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="stat-pill">
                    <div class="stat-label">Stored Laptops</div>
                    <div class="stat-value">@Model.Laptops.Count</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-md mb-4" role="alert">
            <strong>Success:</strong> @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-5">
        <div class="col-lg-5">
            <div class="card inventory-card shadow-lg h-100">
                <div class="card-body">
                    <h2 class="h4 mb-2">New Equipment</h2>
                    <p class="text-muted small mb-4">Add a verified laptop record to InventoryDB.Laptops.</p>

                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="NewLaptop.ModelName" class="form-label">Model Name</label>
                            <input asp-for="NewLaptop.ModelName" class="form-control form-control-lg" placeholder="Dell Latitude 5450" />
                            <span asp-validation-for="NewLaptop.ModelName" class="text-danger small d-block mt-2"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewLaptop.SerialNumber" class="form-label">Serial Number</label>
                            <input asp-for="NewLaptop.SerialNumber" class="form-control form-control-lg" placeholder="VG-01-2026-1001" />
                            <span asp-validation-for="NewLaptop.SerialNumber" class="text-danger small d-block mt-2"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewLaptop.Price" class="form-label">Price ($)</label>
                            <input asp-for="NewLaptop.Price" type="number" step="0.01" min="0.01" class="form-control form-control-lg" placeholder="1299.99" />
                            <span asp-validation-for="NewLaptop.Price" class="text-danger small d-block mt-2"></span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100 fw-bold">Save to MongoDB</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card inventory-card shadow-lg h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div>
                            <h2 class="h4 mb-1">Live Equipment List</h2>
                            <p class="text-muted small mb-0">All laptop records currently synced from MongoDB.</p>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table inventory-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Model Name</th>
                                    <th>Serial Number</th>
                                    <th class="text-end">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Laptops.Count == 0)
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <div class="fs-5 fw-500">No laptops available</div>
                                            <small>Create the first record using the form on the left.</small>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var laptop in Model.Laptops)
                                    {
                                        <tr>
                                            <td>@laptop.ModelName</td>
                                            <td><code>@laptop.SerialNumber</code></td>
                                            <td class="text-end">@laptop.Price.ToString("C")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
