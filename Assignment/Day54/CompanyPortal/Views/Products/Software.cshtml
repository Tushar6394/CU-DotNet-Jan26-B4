@{
    ViewData["Title"] = "Software";
}

<section class="mb-4">
    <h1 class="display-6 fw-bold">Software Products</h1>
    <p class="text-secondary">This page demonstrates Bootstrap badges and tables.</p>
</section>

<div class="table-responsive shadow-sm rounded-4 overflow-hidden">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Product</th>
                <th>Category</th>
                <th>Status</th>
                <th>Audience</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>InsightCRM</td>
                <td>Customer Management</td>
                <td><span class="badge text-bg-success">Active</span></td>
                <td>Sales Teams</td>
            </tr>
            <tr>
                <td>FlowDesk</td>
                <td>Workflow Automation</td>
                <td><span class="badge text-bg-warning">Pilot</span></td>
                <td>Operations</td>
            </tr>
            <tr>
                <td>LedgerLite</td>
                <td>Finance Reporting</td>
                <td><span class="badge text-bg-primary">Stable</span></td>
                <td>Finance Teams</td>
            </tr>
        </tbody>
    </table>
</div>