@{
    ViewData["Title"] = "Services";
}

<section class="mb-4">
    <h1 class="display-6 fw-bold">Our Services</h1>
    <p class="text-secondary">The services area uses Bootstrap cards for quick summaries and an accordion for service details.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h4">Consulting</h2>
                <p>Architecture reviews, solution planning, and delivery guidance for business systems.</p>
                <a class="btn btn-primary" asp-action="Consulting">Learn More</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h4">Training</h2>
                <p>Instructor-led sessions and practical exercises for developers, analysts, and support teams.</p>
                <a class="btn btn-primary" asp-action="Training">Learn More</a>
            </div>
        </div>
    </div>
</div>

<div class="accordion shadow-sm" id="servicesAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#serviceOne" aria-expanded="true" aria-controls="serviceOne">
                Discovery and Planning
            </button>
        </h2>
        <div id="serviceOne" class="accordion-collapse collapse show" data-bs-parent="#servicesAccordion">
            <div class="accordion-body">We gather requirements, map workflows, and shape a clear delivery plan before implementation starts.</div>
        </div>
    </div>
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#serviceTwo" aria-expanded="false" aria-controls="serviceTwo">
                Build and Enablement
            </button>
        </h2>
        <div id="serviceTwo" class="accordion-collapse collapse" data-bs-parent="#servicesAccordion">
            <div class="accordion-body">Teams receive implementation support, knowledge transfer, and practical templates they can reuse later.</div>
        </div>
    </div>
</div>