@{
    ViewData["Title"] = "Training";
}

<section class="mb-4">
    <h1 class="display-6 fw-bold">Training Programs</h1>
    <p class="text-secondary">Practical learning programs for teams that want stronger .NET, MVC, and UI skills.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">MVC Basics</h2>
                <p class="mb-0">Controllers, actions, views, routing, and shared layouts.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Bootstrap UI</h2>
                <p class="mb-0">Build responsive interfaces quickly with reusable components.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Project Practice</h2>
                <p class="mb-0">Apply concepts through guided exercises and mini projects.</p>
            </div>
        </div>
    </div>
</div>

<div class="accordion shadow-sm" id="trainingAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#trainingFormat" aria-expanded="true" aria-controls="trainingFormat">
                Training format
            </button>
        </h2>
        <div id="trainingFormat" class="accordion-collapse collapse show" data-bs-parent="#trainingAccordion">
            <div class="accordion-body">Classes mix short lectures, coding demos, exercises, and review sessions to reinforce learning.</div>
        </div>
    </div>
</div>