@model List<NorthwindCatalog.Services.DTOs.ProductDto>

<h2 class="mb-3">Products</h2>

<div class="table-responsive bg-white border rounded shadow-sm">
    <table class="table table-striped table-hover mb-0 align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.ProductName</td>
                    <td>@(p.UnitPrice?.ToString("0.00") ?? "N/A")</td>
                    <td>@(p.UnitsInStock?.ToString() ?? "N/A")</td>
                    <td>@p.InventoryValue.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
</div>