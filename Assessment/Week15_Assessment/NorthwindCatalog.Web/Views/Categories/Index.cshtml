@model List<NorthwindCatalog.Services.DTOs.CategoryDto>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card category-card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top category-image" alt="@item.CategoryName" />
                <div class="card-body text-center d-flex flex-column justify-content-between">
                    <h5 class="card-title mb-3">@item.CategoryName</h5>
                    <a asp-controller="Products"
                       asp-action="ByCategory"
                       asp-route-id="@item.CategoryId"
                       class="btn btn-primary">View Products</a>
                </div>
            </div>
        </div>
    }
</div>