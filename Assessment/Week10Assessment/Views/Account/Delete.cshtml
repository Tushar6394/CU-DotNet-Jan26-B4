@model Week10Assessment.Models.Account
@{
    ViewData["Title"] = "Delete Account";
}

<div class="card border-danger shadow-sm">
    <div class="card-body p-4">
        <h2 class="h4 text-danger">Delete Account</h2>
        <p class="mb-3">Are you sure you want to permanently delete this account?</p>

        <dl class="row mb-4">
            <dt class="col-sm-3">Holder</dt>
            <dd class="col-sm-9">@Model.HolderName</dd>
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.AccountType</dd>
            <dt class="col-sm-3">Balance</dt>
            <dd class="col-sm-9">@Model.Balance.ToString("C")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input asp-for="Id" type="hidden" />
            <span asp-validation-for="Id" class="text-danger d-block mb-3"></span>
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
