@model List<Week10Assessment.Models.Account>
@{
    ViewData["Title"] = "Accounts";
}

<section class="hero-panel mb-4">
    <div>
        <p class="eyebrow mb-2">FinTrack Pro</p>
        <h1 class="display-6 mb-2">Account Ledger</h1>
        <p class="text-secondary mb-0">Persistent banking records powered by EF Core.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-finance">Add New Account</a>
        <a asp-action="Transfer" class="btn btn-outline-light">Transfer</a>
        <a asp-action="Transactions" class="btn btn-outline-light">All Transactions</a>
    </div>
</section>

@if (!Model.Any())
{
    <div class="alert alert-warning shadow-sm">No accounts available. Start by creating your first account.</div>
}
else
{
    <div class="card finance-card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Holder</th>
                            <th>Type</th>
                            <th class="text-end">Balance</th>
                            <th>Opened On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var typeBadgeClass = item.AccountType == "Savings" ? "bg-success-subtle text-dark border border-success-subtle" :
                                             item.AccountType == "Current" ? "bg-primary-subtle text-dark border border-primary-subtle" :
                                             item.AccountType == "Investment" ? "bg-warning-subtle text-dark border border-warning-subtle" :
                                             "bg-secondary-subtle text-dark border border-secondary-subtle";

                        <tr>
                            <td>@item.HolderName</td>
                            <td><span class="badge @typeBadgeClass">@item.AccountType</span></td>
                            <td class="text-end fw-semibold">@item.Balance.ToString("C")</td>
                            <td>@item.OpenedOn.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (TempData["Success"] is string success)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">
        <div id="accountToast" class="toast border-0 finance-toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">FinTrack Pro</strong>
                <small>Now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @success
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const toastEl = document.getElementById("accountToast");
                if (toastEl) {
                    const toast = new bootstrap.Toast(toastEl, { delay: 3200 });
                    toast.show();
                }
            });
        </script>
    }
}
